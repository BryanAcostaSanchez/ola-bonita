NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Las credenciales de Clip se configuran dentro de la app (Configuración > Pagos)
# y se almacenan cifradas en Supabase Vault. Nunca agregues secretos de Clip aquí.
NEXT_PUBLIC_APP_URL=https://app.olabonita.shop
NEXT_PUBLIC_SITE_URL=https://olabonita.shop
RESEND_API_KEY=re_...
EMAIL_FROM="Ola Bonita <notificaciones@olabonita.shop>"
# Secreto privado de Vercel Cron para conciliar enlaces Clip. No usar NEXT_PUBLIC_.
CRON_SECRET=
# Clip no firma sus webhooks, así que la URL que le entregamos lleva este
# secreto. Valor largo y aleatorio, privado. No usar NEXT_PUBLIC_.
CLIP_WEBHOOK_TOKEN=
